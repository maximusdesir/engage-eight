# Engage Eight API configuration. Copy to `.env` and adjust.

# Development mode. Defaults to false (fail closed): the app then refuses to
# start unless ENGAGE8_JWT_SECRET is set to a real value. This file turns it on
# for local development only; never set it in production.
ENGAGE8_DEBUG=true

# JWT signing key. REQUIRED in production. Generate one with:
#   openssl rand -hex 32
ENGAGE8_JWT_SECRET=dev-secret-change-me

# Database. Defaults to a local SQLite file. Use a Postgres URL in production.
# Plain postgresql:// URLs (as Neon and Render give them) are accepted too:
#   ENGAGE8_DATABASE_URL=postgresql+psycopg://user:password@host:5432/engage8
# ENGAGE8_DATABASE_URL=

# Allowed CORS origins for the frontend, as a JSON list:
#   ENGAGE8_CORS_ORIGINS=["https://your-frontend.vercel.app"]
# ENGAGE8_CORS_ORIGINS=

# Per-IP rate limiting (on by default). Behind a proxy, name the header it sets
# with the visitor's IP (Render: cf-connecting-ip). Never X-Forwarded-For.
# ENGAGE8_RATE_LIMIT_ENABLED=true
# ENGAGE8_CLIENT_IP_HEADER=

# Most demo accounts alive at once (each is deleted after 24 h).
# ENGAGE8_DEMO_MAX_ACCOUNTS=300
